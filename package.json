{
  "name": "reviewlink-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"test-build/tests/*.test.js\"",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "test:e2e": "node scripts/e2e-check.mjs",
    "test:integration": "tsc -p tsconfig.test.json && node --test \"test-build/tests/integration/*.test.js\"",
    "start": "next start",
    "test:resolver": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"test-build/tests/experiments/*.test.js\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Generator link Google Review gratis: Place ID atau link ulasan resmi menjadi tautan siap dibagikan. Statis, tanpa backend."
}
