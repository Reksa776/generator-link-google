# --- Optional: Google Places API (New), server-side only ---------------------
# The browser based resolver (Playwright) can find the Place ID without a key.
# This key is only an additional, paid-quota fallback.
GOOGLE_MAPS_API_KEY=

# --- Experimental Playwright resolver (default: off) -------------------------
# 1 = enabled. Measured cost: ~20 s and ~250 MB RSS per resolution.
PLAYWRIGHT_RESOLVER_ENABLED=0
# Maximum simultaneous browser resolutions (default 1).
PLAYWRIGHT_MAX_CONCURRENCY=1
# Optional: path to a Chromium/Chrome binary (otherwise Playwright's own).
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# --- Public base URL for metadata/SEO ---------------------------------------
NEXT_PUBLIC_SITE_URL=https://reviewlink-generator.example.com
